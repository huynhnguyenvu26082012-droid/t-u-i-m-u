<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mở Túi Mù Ngẫu Nhiên</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="main-container">
    <h2>🎁 SHOP TÚI MÙ MAY MẮN 🎁</h2>

    <!-- Ô nhập Mã Key -->
    <div class="input-box">
      <input type="text" id="inputKey" placeholder="Nhập mã Key (30k) vào đây..." autocomplete="off">
    </div>

    <!-- Túi Mù -->
    <div class="blindbag-container">
      <div id="blindBag" class="blind-bag" onclick="moTuiMu()">
        <div class="bag-skin">
          <span class="bag-icon">🎁</span>
          <p class="bag-text">BẤM ĐỂ MỞ TÚI</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Popup Hóa Đơn -->
  <div id="resultModal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <span class="close-btn" onclick="dongModal()">&times;</span>
      <div id="invoicePrint"></div>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
